{
  "name": "burrow",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "postinstall": "bun run fetch:mole",
    "dev": "bun run fetch:mole && mygo dev",
    "build": "bun run fetch:mole && mygo build",
    "generate": "mygo generate",
    "fetch:mole": "go run ./tools/fetchmole",
    "check": "bun run check:go && bun run check:web",
    "check:go": "go vet ./... && go run github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.15.0 run && go test -race ./...",
    "check:web": "bun run check:generated && biome check && tsc --noEmit && vitest run",
    "check:generated": "mygo generate && git diff --exit-code -- src/mygo.ts",
    "test:integration": "bun run fetch:mole && go test -race -tags integration ./...",
    "test:e2e": "playwright test",
    "test:smoke": "go test -count=1 -tags smoke ./e2e/smoke/...",
    "test:realtrash": "go test -count=1 -tags realtrash ./e2e/realtrash/...",
    "dev:web": "vite",
    "build:web": "vite build"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "1.3.12",
    "@radix-ui/react-tabs": "1.2.1",
    "mygo-runtime": "0.6.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "mygo-cli": "0.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
